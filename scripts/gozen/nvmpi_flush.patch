 	if (!ctx)
 		return -1;
 
+	/* Closing: the capture thread must not wait for a resolution-change
+	 * event that cannot come any more (a decoder closed before it saw a
+	 * keyframe, e.g. right after a flush). Without this, close() took
+	 * about 1 s on JetPack 6 (two 500 ms dqEvent waits), stalling every
+	 * video switch in an application. */
+	ctx->closing.store(true);
+
+	/* Let the decoder finish the bitstream already queued before tearing it
+	 * down: closed mid-stream (a video switched while playing), NVIDIA's
+	 * decoder thread crashed in libnvmmlite_video about 1 close in 20 on
+	 * JetPack 6 (inside v4l2_close or after the buffers were freed). Wait,
+	 * at most 300 ms, until the OUTPUT plane has nothing queued; the
+	 * capture thread keeps returning CAPTURE buffers meanwhile (it drops
+	 * frames instead of waiting for the pool while closing). */
+	if (ctx->numberCaptureBuffers > 0 && ctx->dec_capture_loop.joinable() && !ctx->eos.load())
+	{
+		auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+		while (ctx->dec->output_plane.getNumQueuedBuffers() > 0 &&
+		       std::chrono::steady_clock::now() < deadline && !ctx->dec->isInError())
+		{
+			struct v4l2_buffer v4l2_buf;
+			struct v4l2_plane planes[MAX_PLANES];
+			memset(&v4l2_buf, 0, sizeof(v4l2_buf));
+			memset(planes, 0, sizeof(planes));
+			v4l2_buf.m.planes = planes;
+			if (ctx->dec->output_plane.dqBuffer(v4l2_buf, NULL, NULL, 0) < 0)
+				usleep(2000);
+		}
+		usleep(20000);   //the last buffer taken may still be decoding
+	}
 	ctx->eos.store(true);
 	/* Unblock any get_frame() caller blocked in dqFilledBuf(timeout)
 	 * before STREAMOFF — otherwise the consumer hangs until its timeout
@@ -373,9 +408,23 @@ int nvmpi_decoder_close(nvmpictx* ctx)
 		NvBufferSessionDestroy(ctx->session);
 #endif
 
