+	std::lock_guard<std::mutex> lock(nvmpi_dec_setup_mutex);
 	ctx->dec->output_plane.setStreamStatus(false);
 	ctx->dec->output_plane.deinitPlane();
 
+	/* Close the decoder device before freeing the CAPTURE DMA buffers and
+	 * the frame pool: closed mid-stream (a video switched while playing),
+	 * NVIDIA's decoder thread could still write a frame into a buffer
+	 * already destroyed and crash (libnvmmlite_video, about 1 close in 10
+	 * on JetPack 6). deinitDecoderCapturePlane() is split around it. */
