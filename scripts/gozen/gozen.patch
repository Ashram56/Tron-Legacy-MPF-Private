-		close();
-		return _log_err("Couldn't open codec");
+	if (!av_codec || !av_codec_ctx) {
+		if (!av_codec || hw_tried)
+			av_codec = avcodec_find_decoder(av_stream->codecpar->codec_id);
+		if (!av_codec) { // Couldn't find decoder so exit.
+			close();
+			return _log_err("Couldn't find decoder");
+		}
+		if (!_open_decoder(av_codec)) {
+			close();
+			return _log_err("Couldn't open codec");
+		}
 	}
 
 	// Adjust resolution according to the aspect ratio.
