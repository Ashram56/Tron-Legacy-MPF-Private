+	// Hardware decoder first (NVIDIA Jetson: FFmpeg patched by jetson-ffmpeg registers <codec>_nvmpi, which
+	// loads libnvmpi.so at run time). GOZEN_HWDEC=0 turns it off. Falls back to the software decoder when the
+	// hardware one is missing or fails to open (no libnvmpi.so, not a Jetson).
+	bool hw_tried = false;
+	if (!av_codec && OS::get_singleton()->get_environment("GOZEN_HWDEC") != "0") {
+		const AVCodecDescriptor* desc = avcodec_descriptor_get(av_stream->codecpar->codec_id);
+		const AVCodec* hw_codec = desc ? avcodec_find_decoder_by_name((String(desc->name) + "_nvmpi").utf8().get_data())
+									   : nullptr;
+		if (hw_codec) {
+			hw_tried = true;
+			if (_open_decoder(hw_codec)) {
+				av_codec = hw_codec;
+				UtilityFunctions::print("GoZen: hardware decoder ", hw_codec->name);
+			} else {
+				UtilityFunctions::print("GoZen: hardware decoder ", hw_codec->name, " unavailable, using software");
+				av_codec_ctx.reset();
+			}
+		}
 	}
-
-	FFmpeg::enable_multithreading(av_codec_ctx.get(), av_codec);
