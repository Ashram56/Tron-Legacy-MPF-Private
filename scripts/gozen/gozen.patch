Patch to GDE GoZen (github.com/VoylinsGamedevJourney/gde_gozen) at f9448619, applied by scripts/build_gozen.sh
(git apply ignores this text): asks FFmpeg for <codec>_nvmpi (the Jetson's hardware decoder) first and falls back
to software; SConstruct lean=yes. Hardware decoding tested on Jetson AGX Orin, L4T R36.4.3 / JetPack 6.2;
Xavier NX (L4T R35) not tested yet. Software decoding: any Linux x86_64 / arm64.

diff --git a/SConstruct b/SConstruct
index 5e7fcdf..923d50c 100644
--- a/SConstruct
+++ b/SConstruct
@@ -34,10 +34,16 @@ if "linux" in platform:
         LIBPATH=["ffmpeg/bin/lib", "ffmpeg/bin/lib64"],
         LIBS=LIBS_COMMON,
     )
-    env.Append(LIBS=["tls", "ssl", "crypto", "vpx", "aom"])
-
-    if arch != "arm64":
-        env.Append(LIBS=["z"])
+    # lean=yes: FFmpeg built without libvpx, libaom, LibreSSL and zlib (the Jetson build of
+    # Tron-Legacy-MPF-PuP, scripts/build_gozen.sh)
+    # (and with FFmpeg's assembly, whose static objects need -Bsymbolic to link into a shared library)
+    if ARGUMENTS.get("lean", "no") == "yes":
+        env.Append(LINKFLAGS=["-Wl,-Bsymbolic"])
+    else:
+        env.Append(LIBS=["tls", "ssl", "crypto", "vpx", "aom"])
+
+        if arch != "arm64":
+            env.Append(LIBS=["z"])
     env.Append(LIBS=["m", "pthread", "dl"])
 elif "windows" in platform:
     env.Append(LINKFLAGS=["-static"], LIBS=LIBS_COMMON)
