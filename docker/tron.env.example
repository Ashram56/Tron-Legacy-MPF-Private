# Local settings for docker compose. Copy to docker/.env (git-ignored) and edit; docker compose and
# docker/tron.sh read it. Every line is optional.

# Hardware: virtual (desktop, MPF Monitor) or proc (the real machine; adds proc.yml in docker/tron.sh)
#TRON_HW=virtual
#TRON_MACHINE=pro      # or le: Tron Legacy Pro (default) or LE IO assignments
#TRON_FIBER_OPTICS=1   # drive the ramp light tubes on a Pro (always on with an LE)

# DMD window (Godot). Monitors of one X desktop are numbered 0, 1, 2... in the order your display settings
# list them. Pick a monitor and fill it:
#DMD_SCREEN=1
#DMD_FULLSCREEN=1
# ...or place and size the window yourself (desktop coordinates; this one is the right half of a 3840x1080 desktop):
#DMD_POSITION=1920,0
#DMD_RESOLUTION=1920x480
# ...or a separate X screen / X server (a display name):
#DMD_DISPLAY=:0.1

# MPF Monitor: its windows remember where you dragged them (game/monitor/settings.ini). To open it on another
# X screen or server instead:
#MONITOR_DISPLAY=:0.2

# Rendering: opengl3 (default, works everywhere) or vulkan (needs the GPU, gpu.yml)
#GODOT_RENDERING_DRIVER=opengl3
# Extra Godot options, e.g. keep the DMD above other windows:
#GODOT_ARGS=--always-on-top

# MPF's text UI in the mpf container (then: docker attach tron-legacy-mpf-mpf-1, detach with Ctrl+P Ctrl+Q)
#FREE_PLAY=0       # factory pricing on the virtual machine: coins needed (key 5 in the DMD window)
#MPF_TEXT_UI=1

# Turn off what docker/tron.sh would otherwise add when the host has it: GPU (/dev/dri), sound (PulseAudio)
#TRON_GPU=0
#TRON_AUDIO=0

# 0: Godot draws on its main thread instead of its separate render thread, should a GPU driver misbehave with it
#TRON_RENDER_THREAD=0

# Seconds of DMD capture for `docker/tron.sh run --rm render-check`
#RENDER_SECONDS=15
