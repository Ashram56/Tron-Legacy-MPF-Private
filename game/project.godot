; Engine configuration file.

config_version=5

[application]

config/name="Tron Legacy MPF"
run/main_scene="res://slides/window.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

DmdMode="*res://tools/dmd_mode.gd"
DmdScreen="*res://tron/dmd_screen.gd"
MPF="*res://addons/mpf-gmc/mpf_gmc.gd"
DmdCapture="*res://tools/dmd_capture.gd"
ProcDmd="*res://tools/proc_dmd.gd"
Pup="*res://pup/pup_player.gd"
PerfProbe="*res://tools/perf_probe.gd"

[display]

window/size/viewport_width=128
window/size/viewport_height=32
window/size/window_width_override=1024
window/size/window_height_override=256
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[tron]

dmd/mode="hd"
dmd/dots=0
dmd/tint="blue"
dmd/text_glow=0.8
dmd/font="rajdhani"
dmd/text_scale=0.85
dmd/preload_min_frames=40
dmd/preload_small=true
dmd/pool_slides=true
dmd/renderer="data"

[editor_plugins]

enabled=PackedStringArray("res://addons/mpf-gmc/plugin.cfg")

[rendering]

rendering_device/pipeline_cache/save_chunk_size_mb=0.1
renderer/rendering_method="mobile"
driver/threads/thread_model=2
textures/canvas_textures/default_texture_filter=0

[threading]

worker_pool/low_priority_thread_ratio=0.5
